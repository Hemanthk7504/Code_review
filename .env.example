# Security & Auth
API_KEY=

# LLM Cognitive Engine Configuration
LLM_ENABLED=false
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1
LLM_CONCURRENCY=4

# GitHub Integration & Bot Settings
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
BOT_BRANCH_PREFIX=ai-review/

# Validation Gate & Quality Thresholds
MIN_RESOLUTION_RATIO=1.0
MAX_NEW_ISSUES=0
VERIFY_BASE_THRESHOLD=0.5
VERIFY_RISK_WEIGHT=0.3
